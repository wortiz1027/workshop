<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 🎨 Propiedad: Formato de Consola Enriquecido con Colores y soporte para Trazas -->
    <!-- %X{traceId} e %X{spanId} inyectarán los IDs de OpenTelemetry si usas Micrometer Tracing -->
    <property name="CONSOLE_LOG_PATTERN" 
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [ %magenta(%X{traceId:-}) , %cyan(%X{spanId:-}) ] [%blue(%thread)] %cyan(%logger{36}) : %msg%n" />

    <!-- 📁 Propiedad: Ruta y Formato para los archivos físicos de Logs -->
    <property name="LOG_FILE_PATH" value="/tmp/logs/api-gateway" />
    <property name="FILE_LOG_PATTERN" 
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [ %X{traceId:-} , %X{spanId:-} ] [%thread] %logger{36} : %msg%n" />
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE_PATH}/gateway-current.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- Política de rotación: Crea un archivo nuevo cada día o cuando pese más de 10MB -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE_PATH}/archived/gateway-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory> <!-- Retener históricos por máximo 7 días -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Nivel TRACE/DEBUG en estos paquetes específicos permite ver el viaje de las rutas hacia Eureka -->
    <logger name="org.springframework.cloud.gateway" level="DEBUG" />
    <logger name="org.springframework.http.server.reactive" level="INFO" />
    <logger name="org.springframework.web.reactive" level="INFO" />
    <logger name="reactor.netty.http.server" level="DEBUG" />
    <logger name="reactor.netty.http.client" level="DEBUG" />

    <!-- Apagamos logs redundantes de Spring Core para no saturar la pantalla -->
    <logger name="org.springframework" level="INFO" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>
