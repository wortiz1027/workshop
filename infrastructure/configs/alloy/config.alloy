logging {
  level  = "info"
  format = "logfmt"
}

// ==========================================
// SECCIÓN DE LOGS (LOKI) - Tu config actual
// ==========================================

// 1. Monitorear de forma dinámica todas las subcarpetas de logs
local.file_match "workshop_logs" {
    path_targets = [
        // 🚀 TARGET 1: Servicio de Usuarios
        {
            __address__  = "localhost",
            __path__     = "/var/log/spring/users/*.log",
            app          = "users",
            service_name = "users",
        },
        // 🚀 TARGET 2: Servicio de Productos
        {
            __address__  = "localhost",
            __path__     = "/var/log/spring/products/*.log",
            app          = "products",
            service_name = "products",
        },
    ]
}

// 2. Leer los archivos encontrados en tiempo real
loki.source.file "scraped_logs" {
    targets    = local.file_match.workshop_logs.targets
    forward_to = [loki.process.parse_json.receiver]
    tail_from_end = true
}

// 3. Procesar las líneas JSON
loki.process "parse_json" {    
    stage.json {
        expressions = { 
            level = "level", 
            logger = "logger",
            application_name = "context",
            environment = "environment",
            app   = "app",
        }
    }
    
    stage.regex {
        source      = "filename"
        expression  = "/var/log/spring/(?P<extracted_app>[^/]+)/"
    }

    stage.labels {
        values = {
            level            = "level",            
            application_name = "application_name", 
            environment      = "environment",      
            app              = "extracted_app",
            service_name     = "extracted_app", 
        }
    }
    forward_to = [loki.write.loki_backend.receiver]
}

// 4. Enviar hacia Loki
loki.write "loki_backend" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
        tenant_id  = "default"
        batch_wait = "1s"
        batch_size = "1MB"
    }
}

// ==========================================
// 🚀 NUEVA SECCIÓN DE TRAZAS (TEMPO)
// ==========================================

// 5. RECEPTOR: Escucha las trazas OTLP que envía tu Spring Boot
otelcol.receiver.otlp "spring_boot_traces" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  // Envía lo recibido al componente exportador de Tempo que está abajo
  output {
    traces = [otelcol.exporter.otlp.send_to_tempo.input]
  }
}

// 6. EXPORTADOR: Envía las trazas directamente a Grafana Tempo
otelcol.exporter.otlp "send_to_tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}